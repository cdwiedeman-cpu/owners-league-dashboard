// THE BACK END, DESCRIBED SO CLOUDFLARE CAN DEPLOY IT ITSELF.
//
// Until now the Worker was uploaded by hand through the dashboard, which needed a signed-in
// browser session and broke every time that session dropped. This file lets Cloudflare watch the
// repository instead: Casey pushes, and the same push that updates the website updates the back
// end and the Monday schedule.
//
// ONE ACTION INSTEAD OF THREE. He was already pushing. Nothing new to remember.
//
// THE BUNDLE IS GENERATED -- never edit backend/worker.bundle.js. Edit code/peloton.js,
// code/board.js or code/worker/worker.js in the kit and run code/worker/build_worker.py.
{
  "name": "rfl",
  "main": "backend/worker.bundle.js",
  "compatibility_date": "2026-09-13",

  // THE STORAGE. Seats, codes, rosters, trades and each person's own settings.
  "kv_namespaces": [
    { "binding": "RFL", "id": "7b5cda3f356b42e0b35951997e0f8e90" }
  ],

  // MONDAY, 4:00pm ARIZONA. 23:00 UTC, and Arizona keeps no daylight saving, so this is correct
  // in January and in July. Do not "fix" it in March.
  // IT IS STILL A SWITCH: the Run It tab's Automatically / I Do It Myself setting is read before
  // anything is settled, so this firing does nothing when it is set to do-it-myself.
  //
  // ===== THE DAY IS SPELLED OUT, AND THAT IS NOT A STYLE CHOICE =====
  //
  // This line used to read `0 23 * * 1`, and on 4 Oct 2026 it settled week 4 on a SUNDAY.
  //
  // CLOUDFLARE COUNTS THE DAYS FROM SUNDAY = 1, NOT FROM SUNDAY = 0. Their own documentation
  // says so and says it is deliberately different: "Days of the week go from 1 = Sunday to
  // 7 = Saturday, which is different on some other cron systems (where 0 = Sunday and
  // 6 = Saturday)." Every other cron in the world reads 1 as Monday. This one reads it as
  // Sunday, so the schedule fired a day early from the moment it was written, and the comment
  // beside it swore it was Monday.
  //
  // NEVER WRITE A NUMBER IN THE LAST FIELD. Cloudflare recommends the three-letter name for
  // exactly this reason, and `test_schedule_guard.js` refuses a bare number here now.
  //
  // AND IT IS NO LONGER THE ONLY THING STANDING BETWEEN A FIRING AND A SETTLED WEEK.
  // `scheduleOK()` in worker.js works the day out from the moment it was fired at, so a firing
  // on any other day, or before 4:00pm AZ, writes `lastScheduleSkip` into KV and settles
  // nothing. Had that existed, this would have been a line in a log instead of eight rosters.
  "triggers": {
    "crons": ["0 23 * * MON"]
  }

  // THE SETUP WORD IS NOT IN HERE. `ADMIN` is a secret, set once in the dashboard, and secrets
  // are not carried in this file for the same reason no key ever is: this file is public.
}
